# 1. Initialization
units metal
atom_style atomic
boundary p p p

# 2. 64-atom Silicon Bulk (2x2x2 diamond unit cells)
lattice diamond 5.431
region box block 0 2 0 2 0 2
create_box 1 box
create_atoms 1 box
mass 1 28.0855

# 3. Interatomic Potential
pair_style sw
pair_coeff * * Si.sw Si

# 4. Settings & Output
velocity all create 1000.0 87287 loop geom
fix 1 all nvt temp 1000.0 1000.0 0.1

# 5. Run simulation
thermo          100
thermo_style    custom step temp press pe ke etotal vol
compute         pe_atom all pe/atom
dump            train_data all custom 100 si_0806.dump id type x y z fx fy fz c_pe_atom
run 10000