# ===================================================================
# GENERAZIONE DATASET SILICIO PER MACHINE LEARNING (POTENZIALE SW)
# ===================================================================

# 1. INIZIALIZZAZIONE DEL SISTEMA
units           metal           # Distanze in Angstrom, Energie in eV, Tempo in ps
dimension       3
boundary        p p p           # Condizioni al contorno periodiche in x, y, z
atom_style      atomic          # Stile atomico standard (senza cariche fisse/legami)

# 2. CREAZIONE DEL RETICOLO E DEGLI ATOMI
lattice         diamond 5.431   # Costante di reticolo sperimentale per il Si
Lattice spacing in x,y,z = 5.431 5.431 5.431
region          box block 0 3 0 3 0 3  # Creiamo una supercella 3x3x3 (216 atomi)
create_box      1 box
Created orthogonal box = (0 0 0) to (16.293 16.293 16.293)
  2 by 2 by 2 MPI processor grid
create_atoms    1 box
Created 216 atoms
  using lattice units in orthogonal box = (0 0 0) to (16.293 16.293 16.293)
  create_atoms CPU = 0.001 seconds
mass            1 28.0855       # Massa del Silicio

# 3. ASSEGNAZIONE DEL POTENZIALE STILLINGER-WEBER
pair_style      sw
# Assicurati di avere il file "Si.sw" nella stessa cartella da cui lanci lo script!
pair_coeff      * * Si.sw Si
Reading sw potential file Si.sw with DATE: 2007-06-11

# 4. IMPOSTAZIONI FISICHE E OUTPUT (IL DATASET)
timestep        0.001           # Time step di 1 fs (0.001 ps)

# Calcoliamo l'energia potenziale su ogni singolo atomo
compute         pe_atom all pe/atom

# Comando DUMP: Questo è il cuore del vostro dataset!
# Ogni 1000 step salverà nel file "dataset.dump":
# ID, Tipo, coordinate (x,y,z), forze (fx,fy,fz) ed energia potenziale
dump            dataset_out all custom 1000 dataset.dump id type x y z fx fy fz c_pe_atom
dump_modify     dataset_out sort id  # Ordina gli atomi per ID per coerenza

# Output a schermo/log per monitorare la simulazione
thermo          1000
thermo_style    custom step temp pe ke etotal press vol

# Inizializziamo le velocità a 300 K
velocity        all create 300.0 12345 dist gaussian

# ===================================================================
# PROTOCOLLO DI DINAMICA MOLECOLARE (Totale: 9,000,000 step = 9000 frame)
# ===================================================================

# FASE 1: Equilibrazione solido cristallino a 300 K
# (Estraiamo 2000 campioni stabili)
fix             1 all nvt temp 300.0 300.0 0.1
run             2000000
